{
  "arch": "hybrid",
  "seq_len": 2048,
  "global_batch_seqs": 192,
  "micro_batch": 8,
  "budget_epochs": 1,
  "seed": 20260926,
  "optim": {
    "peak_lr": 0.0004,
    "betas": [
      0.9,
      0.95
    ],
    "eps": 1e-08,
    "weight_decay": 0.1,
    "grad_clip": 1.0
  },
  "eval_every_tokens": 100000000,
  "weights_at_tokens": [
    100000000,
    250000000,
    500000000,
    1000000000,
    2000000000,
    3000000000
  ],
  "resume_every_steps": 500,
  "eval_parquet": "${MP_VAL_PARQUET}",
  "tokenizer": "${MP_TOKENIZER}",
  "wandb_project": "sallm-matched-pretrain",
  "schedule": {
    "type": "cosine",
    "warmup_frac": 0.04,
    "min_lr_ratio": 0.1
  },
  "expected_params": 126589832,
  "peak_lr_source": "LR probe (pre-registered rule in README.md, same grid and edge rule as the other four)",
  "model_config": {
    "vocab_size": 65536,
    "hidden_size": 512,
    "num_hidden_layers": 22,
    "intermediate_size": 1536,
    "hidden_ratio": null,
    "num_heads": 4,
    "head_dim": 128,
    "expand_v": 2,
    "num_v_heads": null,
    "attn": {
      "layers": [
        3,
        7,
        11,
        15,
        19
      ],
      "num_heads": 8,
      "num_kv_heads": 8,
      "qkv_bias": false,
      "window_size": null,
      "rope_theta": 10000.0
    },
    "attn_mode": "chunk",
    "use_gate": true,
    "use_short_conv": true,
    "conv_size": 4,
    "allow_neg_eigval": false,
    "hidden_act": "swish",
    "max_position_embeddings": 2048,
    "norm_eps": 1e-06,
    "initializer_range": 0.02,
    "fuse_norm": true,
    "fuse_swiglu": true,
    "fuse_cross_entropy": false,
    "fuse_linear_cross_entropy": false,
    "use_l2warp": false,
    "tie_word_embeddings": true,
    "use_cache": false,
    "bos_token_id": 0,
    "eos_token_id": 1,
    "pad_token_id": 2
